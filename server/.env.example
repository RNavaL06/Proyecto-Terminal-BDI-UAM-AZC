# Puerto del Servidor
PORT=5000
NODE_ENV=development

# Configuración de Base de Datos MySQL
# Puedes usar una Service URI (para servicios en la nube como Aiven) o variables individuales
# DB_URI=mysql://avnadmin:tu_password@host:port/defaultdb?ssl-mode=REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=tu_password_mysql
DB_NAME=bdi_final_db

# Seguridad JWT
JWT_SECRET=tu_clave_secreta_jwt_super_segura_aqui

# Autenticación Google OAuth
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Modelos de Inteligencia Artificial (Visión y OCR)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GROQ_API_KEY=tu_groq_api_key_aqui

# Servicios de Geolocalización y Precios
GEOAPIFY_API_KEY=tu_geoapify_api_key_aqui
SERPAPI_API_KEY=tu_serpapi_api_key_aqui

# Servicio de Correo Electrónico (Notificaciones de Caducidad)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion_gmail
EMAIL_FROM="Botiquín Digital Inteligente <tu_correo@gmail.com>"
NOTIF_CRON_ENABLED=true

# URL del Cliente Frontend (CORS)
CLIENT_URL=http://localhost:5173

# Notificaciones Web Push (VAPID)
VAPID_PUBLIC_KEY=tu_vapid_public_key_aqui
VAPID_PRIVATE_KEY=tu_vapid_private_key_aqui
VAPID_SUBJECT=mailto:tu_correo@gmail.com
